{
  "name": "sukimi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-bundle-budget.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "schema": "node scripts/fetch-schema.mjs",
    "fetch:comics": "node scripts/fetch-open-comics.mjs",
    "codegen": "graphql-codegen",
    "typecheck": "tsc -b",
    "test": "node --test scripts/*.test.mjs",
    "test:source-filters": "node --test scripts/verify-source-filters.test.mjs",
    "deploy:server": "node scripts/deploy.mjs",
    "restart:server": "pwsh -NoProfile -File scripts/restart-server.ps1"
  },
  "dependencies": {
    "@apollo/client": "^4.3.1",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@use-gesture/react": "^10.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphql": "^17.0.2",
    "graphql-ws": "^6.3.0",
    "lucide-react": "^1.49.0",
    "motion": "^13.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@graphql-codegen/cli": "^7.4.3",
    "@graphql-codegen/client-preset": "^6.2.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
